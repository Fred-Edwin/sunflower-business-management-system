# Copy to .env and fill in. lib/env.ts validates these at boot — the app
# refuses to start if one is missing or malformed.

# Postgres connection string. docker-compose.yml exposes local Postgres on
# 5432; the default database/user/password there are all "sunflower".
DATABASE_URL=

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The app's own base URL, used to build auth callback links.
BETTER_AUTH_URL=

# Sentry. Optional in development — a clean clone runs without it.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Cloudflare R2 (S3-compatible object storage). Not used until a later phase
# implements lib/storage.ts's adapter interface — optional until then.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
